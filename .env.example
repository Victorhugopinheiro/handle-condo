# Project URL — Settings → General (ou Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Settings → API Keys → Publishable keys (sb_publishable_…)
# Pode usar o nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY com o mesmo valor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Settings → API Keys → Secret keys (sb_secret_…) — só no servidor
# Pode usar o nome antigo SUPABASE_SERVICE_ROLE_KEY com o mesmo valor.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Postgres do MESMO projeto — Settings → Database → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

RESIDENT_SESSION_SECRET=replace-with-a-long-random-secret
